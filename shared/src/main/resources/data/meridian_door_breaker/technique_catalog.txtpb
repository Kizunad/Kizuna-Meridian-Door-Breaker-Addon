# 功法目录清单，schema_version 同时标识清单格式。
schema_version: 1
namespace: "meridian_door_breaker"
binding_templates { id: "human:adult" version: 1 }

books {
  id: "meridian_door_breaker:door_breaker"
  display_name: "破门斩"
  held_item_rules {
    categories {
      id: "axes"
      item_tags: "meridian_door_breaker:axes"
      selection_priority: 0
      base_damage_source: ITEM_ATTACK_DAMAGE
      base_damage { value: 1 unit: RATIO }
      injury_kind: CUTTING
      shield_interaction: BREAK_BEFORE_HIT
      can_break_doors: true
    }
    categories {
      id: "edged_melee_tools"
      item_tags: "meridian_door_breaker:edged"
      selection_priority: 1
      base_damage_source: ITEM_ATTACK_DAMAGE
      base_damage { value: 0.8 unit: RATIO }
      injury_kind: CUTTING
      shield_interaction: COOLDOWN_AFTER_BLOCK
      can_break_doors: true
    }
    categories {
      id: "melee_tools"
      item_tags: "meridian_door_breaker:melee_tools"
      selection_priority: 1
      base_damage_source: ITEM_ATTACK_DAMAGE
      base_damage { value: 0.8 unit: RATIO }
      injury_kind: BLUNT
      shield_interaction: COOLDOWN_AFTER_BLOCK
      can_break_doors: true
    }
    categories {
      id: "handheld_misc"
      item_tags: "meridian_door_breaker:handheld_misc"
      selection_priority: 4
      base_damage_source: FIXED_DAMAGE
      base_damage { value: 0.5 unit: DAMAGE_POINT }
      injury_kind: BLUNT
      shield_interaction: NO_SHIELD_BREAK
      can_break_doors: false
    }
    categories {
      id: "block_items"
      item_tags: "meridian_door_breaker:block_items"
      selection_priority: 3
      base_damage_source: FIXED_DAMAGE
      base_damage { value: 1 unit: DAMAGE_POINT }
      injury_kind: BLUNT
      shield_interaction: NO_SHIELD_BREAK
      can_break_doors: false
    }
    categories {
      id: "other_items"
      selection_priority: 4
      base_damage_source: FIXED_DAMAGE
      base_damage { value: 0.5 unit: DAMAGE_POINT }
      injury_kind: BLUNT
      shield_interaction: NO_SHIELD_BREAK
      can_break_doors: false
    }
    durability {
      item_tags: "meridian_door_breaker:iron_axes"
      multiplier { value: 1 unit: RATIO }
    }
    durability {
      item_tags: "meridian_door_breaker:axes"
      multiplier { value: 2 unit: RATIO }
    }
    durability {
      item_tags: "meridian_door_breaker:durable_tools"
      multiplier { value: 2 unit: RATIO }
    }
    durability { multiplier { value: 3 unit: RATIO } }
    selection_order: CATEGORY_PRIORITY
    selection_order: DURABILITY_MULTIPLIER
    selection_order: PREFER_MAIN_HAND
  }
}

volumes {
  id: "meridian_door_breaker:upper"
  book_id: "meridian_door_breaker:door_breaker"
  display_name: "破门斩·上卷·木门"
  techniques { id: "meridian_door_breaker:knock" version: 1 }
  techniques { id: "meridian_door_breaker:cleave" version: 1 }
  techniques { id: "meridian_door_breaker:ram" version: 1 }
}
volumes {
  id: "meridian_door_breaker:middle"
  book_id: "meridian_door_breaker:door_breaker"
  display_name: "破门斩·中卷·铁门"
  techniques { id: "meridian_door_breaker:hook" version: 1 }
  techniques { id: "meridian_door_breaker:sweep" version: 1 }
  techniques { id: "meridian_door_breaker:close" version: 1 }

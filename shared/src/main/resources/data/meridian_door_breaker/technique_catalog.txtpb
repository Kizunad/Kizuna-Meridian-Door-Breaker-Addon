}

definitions {
  id: "meridian_door_breaker:knock"
  version: 1
  ai_hints {
    minimum_distance { value: 0 unit: METER }
    maximum_distance { value: 3 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
    combat { maximum_warmup_under_attack_millis: 2500 }
  }
  category: ATTACK
  minimum_realm: WANDERING_QI
  slots {
    id: "hand_meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 1
    maximum_count: 6
    require_opened: true
  }
  cost {
    qi {
      slot_id: "hand_meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: FREE
      amount { value: 3 unit: QI }
      distribution: EVEN
    }
  }
  phases { warmup_millis: 900 active_millis: 800 recovery_millis: 1300 interruptible_by_damage: false }
  cooldown_millis: 1000
  effects {
    at_millis: 0
    presentation {
      id: "meridian_door_breaker:door_breaker_knock"
      duration: UNTIL_RECOVERY_END
      start_millis: 0
    }
  }
  effects {
    at_millis: 0
    sound {
      sound_id: "minecraft:item.armor.equip_leather" anchor: CASTER
      volume { value: 0.5 unit: RATIO } pitch { value: 0.9 unit: RATIO }
    }
  }
  effects {
    at_millis: 900
    sound {
      sound_id: "minecraft:entity.player.attack.weak" anchor: CASTER
      volume { value: 0.5 unit: RATIO } pitch { value: 0.8 unit: RATIO } pitch_jitter { value: 0.05 unit: RATIO }
    }
  }
  effects {
    at_millis: 900
    weapon_strike {
      shape: SINGLE_TARGET
      distance { value: 3 unit: METER }
      angle { value: 60 unit: DEGREE }
      facing_offset { value: 0 unit: DEGREE }
      multiplier { value: 0.3 unit: RATIO }
      maximum_targets: 1
      cast_target_limit: 1
      knockback { value: 0 unit: RATIO }
      can_two_hand: false
      two_hand_multiplier { value: 1 unit: RATIO }
      break_shield: false
      injury_override: BLUNT
      last_strike: false
      durability_base: 1
      shield_cooldown_millis: 0
      shield_break_millis: 0
      dedup_group: "knock_1"

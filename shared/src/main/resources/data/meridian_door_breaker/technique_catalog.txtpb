    }
  }
  presentation {
    icon_id: "meridian_door_breaker:knock"
    display_name: "叩门"
    description: "名字叫叩门，传出来时叫人以为是登门拜访的礼数。前面两声轻笃，敲在门板上确实像个问路的客人；可这手腕还没收回去，第三下重击就砸碎了门闩，屋里人连应一声都来不及。"
  }
  movement_speed_multiplier: 0.4
  follow_up {
    transitions {
      previous { id: "meridian_door_breaker:ram" version: 1 }
      recovery_start_ratio { value: 0.5 unit: RATIO }
      after_recovery_millis: 500
      start_millis: 100
    }
  }
}


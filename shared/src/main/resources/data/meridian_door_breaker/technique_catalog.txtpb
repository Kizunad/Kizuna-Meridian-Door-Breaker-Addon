  effects {
    at_millis: 1700
    sound {
      sound_id: "minecraft:entity.player.attack.weak" anchor: CASTER
      volume { value: 0.6 unit: RATIO } pitch { value: 0.7 unit: RATIO } pitch_jitter { value: 0.05 unit: RATIO }
    }
  }
  effects {
    at_millis: 1700
    weapon_strike {
      shape: SINGLE_TARGET
      distance { value: 3 unit: METER }
      angle { value: 60 unit: DEGREE }
      facing_offset { value: 0 unit: DEGREE }
      multiplier { value: 0.9 unit: RATIO }
      maximum_targets: 1
